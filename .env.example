MONDAY_API_TOKEN=

# The numeric board IDs after you import the two CSVs as separate boards
# (found in the board URL: https://yourteam.monday.com/boards/1234567890)
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# Anthropic API key for the conversational agent
ANTHROPIC_API_KEY=
